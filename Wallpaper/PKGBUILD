  "Parch"
  "PArch2"
  "Sketchy-background"
)

declare -A _pkgname_map=(
  ["AuroraLayers"]="parch-wallpaper-auroralayers"
  ["Cultural"]="parch-wallpaper-cultural"
  ["damavand"]="parch-wallpaper-damavand"
  ["Geometric-wallpapers"]="parch-wallpaper-geometric"
  ["Imaginary_landscape"]="parch-wallpaper-imaginary-landscape"
  ["Natural-wallpapers"]="parch-wallpaper-natural"
  ["Paisley"]="parch-wallpaper-paisley"
  ["parch-fifth-anniversary"]="parch-wallpaper-fifth-anniversary"
  ["parch-forth-anniversary"]="parch-wallpaper-forth-anniversary"
  ["Parch-wallpaper"]="parch-wallpaper-parch-wallpaper"
  ["Parch"]="parch-wallpaper-parch"
  ["PArch2"]="parch-wallpaper-parch2"
  ["Sketchy-background"]="parch-wallpaper-sketchy-background"
)

prepare() {
    cd "$srcdir/arts/Wallpaper"
    if [[ -f "$startdir/mkgnome.sh" ]]; then
        cp "$startdir/mkgnome.sh" ./mkgnome.sh
    fi
    bash mkgnome.sh
}

package_parch-wallpaper-auroralayers() {
    pkgdesc='AuroraLayers wallpapers'
    _install_folder "$srcdir/arts/Wallpaper/AuroraLayers"
}

package_parch-wallpaper-cultural() {
    pkgdesc='Cultural wallpapers'
    _install_folder "$srcdir/arts/Wallpaper/Cultural"
}

package_parch-wallpaper-damavand() {
    pkgdesc='damavand wallpapers'
    _install_folder "$srcdir/arts/Wallpaper/damavand"
}

package_parch-wallpaper-geometric() {
    pkgdesc='Geometric wallpapers'
    _install_folder "$srcdir/arts/Wallpaper/Geometric-wallpapers"
}

package_parch-wallpaper-imaginary-landscape() {
    pkgdesc='Imaginary landscape wallpapers'
    _install_folder "$srcdir/arts/Wallpaper/Imaginary_landscape"
}

package_parch-wallpaper-natural() {
    pkgdesc='Natural wallpapers'
    _install_folder "$srcdir/arts/Wallpaper/Natural-wallpapers"
}

package_parch-wallpaper-paisley() {
    pkgdesc='Paisley wallpapers'
    _install_folder "$srcdir/arts/Wallpaper/Paisley"
}

package_parch-wallpaper-fifth-anniversary() {
    pkgdesc='Parch fifth anniversary wallpapers'
    _install_folder "$srcdir/arts/Wallpaper/parch-fifth-anniversary"
}

package_parch-wallpaper-forth-anniversary() {
    pkgdesc='Parch forth anniversary wallpapers'
    _install_folder "$srcdir/arts/Wallpaper/parch-forth-anniversary"
}

package_parch-wallpaper-parch-wallpaper() {
    pkgdesc='Parch wallpaper collection'
    _install_folder "$srcdir/arts/Wallpaper/Parch-wallpaper"
}

