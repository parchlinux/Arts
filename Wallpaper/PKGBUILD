    pkgdesc='PArch2 wallpapers'
    _install_folder "$srcdir/arts/Wallpaper/PArch2"
}

package_parch-wallpaper-sketchy-background() {
    pkgdesc='Sketchy background wallpapers'
    _install_folder "$srcdir/arts/Wallpaper/Sketchy-background"
}

package_parch-wallpapers() {
    pkgdesc='Wallpapers for Parch Linux (meta package)'
    depends=(
        parch-wallpaper-auroralayers
        parch-wallpaper-cultural
        parch-wallpaper-damavand
        parch-wallpaper-geometric
        parch-wallpaper-imaginary-landscape
        parch-wallpaper-natural
        parch-wallpaper-paisley
        parch-wallpaper-fifth-anniversary
        parch-wallpaper-forth-anniversary
        parch-wallpaper-parch-wallpaper
        parch-wallpaper-parch
        parch-wallpaper-parch2
        parch-wallpaper-sketchy-background
    )

    install -Dm644 "${srcdir}/arts/LICENSE" \
        "${pkgdir}/usr/share/licenses/parch-wallpapers/LICENSE"
}

_install_folder() {
    local folder="$1"
    local folder_name
    folder_name=$(basename "$folder")
    local xml_file="$srcdir/arts/Wallpaper/${pkgname}.xml"

    install -d "${pkgdir}/usr/share/wallpapers/${folder_name}"
    find "$folder" -maxdepth 1 -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.svg" \) \
        -exec install -Dm644 -t "${pkgdir}/usr/share/wallpapers/${folder_name}/" {} +

    if [[ -f "$xml_file" ]]; then
        install -Dm644 "$xml_file" \
            "${pkgdir}/usr/share/gnome-background-properties/${pkgname}.xml"
    fi

    install -Dm644 "${srcdir}/arts/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}


