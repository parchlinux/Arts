pkgrel=1
pkgdesc='Meta package for all Parch Linux wallpapers'
arch=("any")
url="https://github.com/parchlinux/arts"
license=("BSD-3-Clause")
source=("git+https://github.com/parchlinux/arts")
md5sums=('SKIP')

_folders=(
  "AuroraLayers"
  "Cultural"
  "damavand"
  "Geometric-wallpapers"
  "Imaginary_landscape"
  "Natural-wallpapers"
  "Paisley"
  "parch-fifth-anniversary"
  "parch-forth-anniversary"
